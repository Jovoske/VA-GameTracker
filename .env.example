# Copy to .env (start.bat does this automatically) and fill in secrets.

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=gamesense
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=gamesense

# ── Host ports ──────────────────────────────────────────────
API_PORT=8000
WEB_PORT=8080
DB_PORT=5432
REDIS_PORT=6379

# ── Security ────────────────────────────────────────────────
# The server (serve.py) refuses to start with this published value, or any secret
# shorter than 32 characters. `python -m app.manage new-secret` writes a fresh one
# here and keeps saved camera logins readable. APP_ENV=development skips the check,
# for a laptop only: never set it on the server.
JWT_SECRET=dev-secret-change-me-please
# Key for saved camera-login passwords; blank = derived from JWT_SECRET. Before
# changing JWT_SECRET, set this and let one photo fetch run (or put the old secret in
# PREVIOUS_JWT_SECRET), or every saved camera login has to be typed in again.
CREDENTIALS_KEY=
PREVIOUS_JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=43200
# Peers whose CF-Connecting-IP header is believed (the Cloudflare tunnel, which on
# Db01 connects from the same machine). A JSON list.
TRUSTED_PROXIES=["127.0.0.1","::1"]
# The interactive API docs (/docs) are off; 1 turns them on (not on a public address).
ENABLE_API_DOCS=0

# ── Initial admin user (seeded on first start) ──────────────
# The server won't start while an admin still has this published password; change it
# in Settings, or `python -m app.manage set-password EMAIL`.
ADMIN_EMAIL=admin@gamesense.local
ADMIN_PASSWORD=changeme

# ── Estate (seeded on first start) ──────────────────────────
ESTATE_NAME=Piedras Lisas
ESTATE_TIMEZONE=Europe/Madrid
ESTATE_LAT=39.0947
ESTATE_LON=-1.3608

# ── SPYPOINT (Milestone 1) ──────────────────────────────────
SPYPOINT_USERNAME=
SPYPOINT_PASSWORD=
SYNC_INTERVAL_MINUTES=15
# Suntek (FTP/email) spool, for the waiting/failed counts in Settings. Blank =
# ftp-spool beside MODELS_ROOT (C:\GameSense\data\ftp-spool on Db01).
FTP_SPOOL_ROOT=

# ── Cloud vision: stag/hind + boar sex (optional) ───────────
# Only needed for the Animals sex pass. Get a key at console.anthropic.com.
# Leave blank to run fully offline (group typing still works without it).
ANTHROPIC_API_KEY=

# ── Storage / retention ─────────────────────────────────────
# Laptop = small rolling window; Phase-2 server >= 365.
MEDIA_RETENTION_DAYS=30
MEDIA_ROOT=/data/media
MODELS_ROOT=/data/models
