# Copy to .env (start.bat does this automatically) and fill in secrets.

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=gamesense
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=gamesense

# ── Host ports ──────────────────────────────────────────────
API_PORT=8000
WEB_PORT=8080
DB_PORT=5432
REDIS_PORT=6379

# ── Security ────────────────────────────────────────────────
# REQUIRED. Generate one and keep it: rotating it signs everyone out AND makes
# stored SPYPOINT passwords unreadable (they are encrypted with a key derived
# from it), so each account would need its password re-entered.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Initial admin user (seeded on first start) ──────────────
# Only used to create the first login. Change the password after signing in;
# further users are managed in-app under Settings.
ADMIN_EMAIL=admin@gamesense.local
ADMIN_PASSWORD=

# ── Estate (seeded on first start) ──────────────────────────
ESTATE_NAME=Piedras Lisas
ESTATE_TIMEZONE=Europe/Madrid
ESTATE_LAT=39.0947
ESTATE_LON=-1.3608

# ── SPYPOINT (Milestone 1) ──────────────────────────────────
SPYPOINT_USERNAME=
SPYPOINT_PASSWORD=
SYNC_INTERVAL_MINUTES=15

# ── Cloud vision: stag/hind + boar sex (optional) ───────────
# Only needed for the Animals sex pass. Get a key at console.anthropic.com.
# Leave blank to run fully offline (group typing still works without it).
ANTHROPIC_API_KEY=

# ── Storage / retention ─────────────────────────────────────
# Laptop = small rolling window; Phase-2 server >= 365.
MEDIA_RETENTION_DAYS=30
MEDIA_ROOT=/data/media
MODELS_ROOT=/data/models
