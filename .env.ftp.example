# Copy to .env.ftp.local (gitignored). No service runs until explicitly started.
# One dedicated account / spool / importer per physical camera.
FTP_USERNAME=suntek-01
FTP_PASSWORD=
FTP_CAMERA_ID=
# Must match the clock timezone configured on the camera.
FTP_CAMERA_TIMEZONE=Europe/Madrid
# Default bindings permit local tests only. Select server interface for deployment.
FTP_BIND_ADDRESS=127.0.0.1
FTP_CONTROL_PORT=2121
# Public IPv4 advertised for passive data connections; required behind NAT.
FTP_PUBLIC_IP=
