# Production template for Db01 (or any Linux server).
# Copy to .env next to compose.yaml, fill in every "change-me", then:
#   docker compose -f compose.yaml -f compose.prod.yaml up -d --build

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=gamesense
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gamesense

# ── Edge (Caddy) ────────────────────────────────────────────
# Leave DOMAIN empty to serve plain HTTP on port 80 (LAN / Tailscale /
# Cloudflare Tunnel). Set it to a domain that points at this server to get
# automatic HTTPS (ports 80+443 must be reachable from the internet).
DOMAIN=
HTTP_PORT=80
HTTPS_PORT=443

# ── Security ────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Initial admin user (seeded on first start) ──────────────
ADMIN_EMAIL=admin@gamesense.local
ADMIN_PASSWORD=change-me

# ── Estate ──────────────────────────────────────────────────
ESTATE_NAME=Piedras Lisas
ESTATE_TIMEZONE=Europe/Madrid
ESTATE_LAT=39.0947
ESTATE_LON=-1.3608

# ── SPYPOINT ────────────────────────────────────────────────
SPYPOINT_USERNAME=
SPYPOINT_PASSWORD=
SYNC_INTERVAL_MINUTES=15

# ── Cloud vision: stag/hind + boar sex (optional) ───────────
ANTHROPIC_API_KEY=

# ── Storage / retention ─────────────────────────────────────
# The server IS the archive (docs/07-deployment.md): keep >= 365 days.
MEDIA_RETENTION_DAYS=365
# Host folder for the photo archive — put it on the big disk and create it
# before first start: sudo mkdir -p /srv/gamesense/media
MEDIA_PATH=/srv/gamesense/media
MEDIA_ROOT=/data/media
MODELS_ROOT=/data/models
