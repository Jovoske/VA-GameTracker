{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "frontend-db01",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set VITE_API_PROXY=http://db01:8090&& npm --prefix frontend run dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--reload", "--port", "8000"],
      "port": 8000
    }
  ]
}
